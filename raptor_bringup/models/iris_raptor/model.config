<?xml version="1.0"?>
<model>
  <name>iris_raptor</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Aycan Coskun</name>
  </author>
  <description>
    ArduPilot iris quadcopter with a 2D 360-degree LiDAR and an upward-facing
    camera. Derived from ardupilot_gazebo/models/iris_with_ardupilot (LGPL-3.0).
  </description>
  <depend>
    <model>
      <uri>model://iris_with_standoffs</uri>
      <version>1.0</version>
    </model>
  </depend>
</model>
