<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Static third-person camera for the demo recording (/demo_camera/image). -->
  <model name="demo_camera">
    <static>true</static>
    <link name="link">
      <sensor name="camera" type="camera">
        <topic>/demo_camera/image</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.05</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>300</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
