<?xml version="1.0"?>
<model>
  <name>raptor_rig</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Aycan Coskun</name>
  </author>
  <description>
    Staged raptor target for the full-loop test: the 0.5 m bird picture on top of a
    thin pole. The upward-facing camera sees the picture and the horizontal LiDAR sees
    the pole, so both sensors observe the same approaching object. Simulation
    counterpart of the printed raptor used in the paper's tests.
  </description>
</model>
