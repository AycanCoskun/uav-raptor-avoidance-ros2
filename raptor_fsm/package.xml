<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>raptor_fsm</name>
  <version>0.1.0</version>
  <description>Six-state sensor fusion state machine that commands ArduPilot through MAVROS.</description>
  <maintainer email="aycancoskuun@gmail.com">Aycan Coskun</maintainer>
  <license>AGPL-3.0-only</license>

  <depend>rclpy</depend>
  <depend>raptor_interfaces</depend>
  <depend>mavros_msgs</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
